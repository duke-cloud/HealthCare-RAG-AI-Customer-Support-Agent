# ═══════════════════════════════════════════════════════════════
#  HealthCare RAG — .gitignore
#  Django + Python ML + FAISS + SQLite
# ═══════════════════════════════════════════════════════════════

# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo

# ── Virtual Environments ────────────────────────────────────────
venv/
env/
.venv/
.env-local/
ENV/
env.bak/
venv.bak/

# ── Django ──────────────────────────────────────────────────────
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
db.sqlite3-shm
db.sqlite3-wal

# Collected static files (generated by collectstatic)
staticfiles/
static_root/

# Media uploads (patient-uploaded files — never commit PHI)
media/documents/
media/avatars/

# ── RAG / ML Index Files ─────────────────────────────────────────
# FAISS vector index (auto-generated — run `python manage.py build_index`)
media/indexes/
*.faiss
*.pkl
*.index

# ── Environment & Secrets ───────────────────────────────────────
.env
.env.*
!.env.example
secrets.json
credentials.json
*.pem
*.key
*.crt
*.p12

# ── IDE & Editor ────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Testing & Coverage ──────────────────────────────────────────
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.tox/
nosetests.xml
test-results/
*.test.db

# ── Build & Distribution ────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
.eggs/
MANIFEST
pip-wheel-metadata/
site/

# ── Jupyter Notebooks ───────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Docker ──────────────────────────────────────────────────────
*.pid
docker-compose.override.yml

# ── Logs & Temp ─────────────────────────────────────────────────
logs/
*.log
tmp/
temp/
.tmp/

# ── PHI / Patient Data (HIPAA — NEVER commit) ───────────────────
# Any file that might contain Protected Health Information
patient_data/
phi/
exports/
reports/
*.csv
*.xlsx
*.xls